# Public URL of the deployed Express/tRPC backend, without a trailing slash.
# Example: https://api.example.com
VITE_API_BASE_URL=

# Browser-visible App Check site key; not a secret. Leave empty until configured in Firebase.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Set to the deployed callable-functions region when it differs from us-central1.
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Server-only values; never expose these as VITE_* variables.
DATABASE_URL=
JWT_SECRET=
SUPER_ADMIN_PHONE=255698232313
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
