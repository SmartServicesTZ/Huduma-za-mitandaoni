rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /license-documents/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write, delete: if false;
    }

    match /lipaUploads/{userId}/{applicationId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && applicationId.matches('[A-Za-z0-9_-]{16,80}')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /lipaApplications/{applicationId}/documents/{fileName} {
      allow read, write, delete: if false;
    }

    match /serviceUploads/{userId}/{applicationId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && applicationId.matches('[A-Za-z0-9_-]{16,80}')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /serviceApplications/{applicationId}/documents/{fileName} {
      allow read, write, delete: if false;
    }

    match /publicChatFiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp|gif)|application/pdf|text/plain|audio/(webm|ogg|mp4|mpeg))');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chatFiles/{roomId}/{userId}/{fileName} {
      function isMember() {
        return request.auth != null
          && firestore.exists(/databases/(default)/documents/conversations/$(roomId))
          && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(roomId)).data.participants;
      }
      allow read: if isMember();
      allow write: if isMember()
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp|gif)|application/pdf|text/plain|audio/(webm|ogg|mp4|mpeg))');
      allow delete: if isMember() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
