rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperAdmin() { return signedIn() && request.auth.token.role == 'super_admin' && request.auth.token.isSuperAdmin == true; }
    function isPrivileged() { return signedIn() && request.auth.token.role in ['admin', 'moderator', 'support', 'super_admin']; }
    function isAdmin() { return isPrivileged(); }
    function hasPermission(name) { return isSuperAdmin() || (isAdmin() && request.auth.token.permissions[name] == true); }
    function hasNoCredentialFields(data) { return !data.keys().hasAny(['password', 'pin', 'pinHash']); }
    function phoneMatchesAuth(data) {
      return data.phone is string
        && request.auth.token.email is string
        && request.auth.token.email.split('@').size() == 2
        && request.auth.token.email.split('@')[0] == data.phone
        && request.auth.token.email.split('@')[1] == 'login.huduma-za-mtandao.local';
    }
    function canManageUsers() { return hasPermission('manageUsers'); }
    function canManageTokens() { return hasPermission('manageTokens'); }
    function canManageServices() { return hasPermission('manageServices'); }
    function canManageContent() { return hasPermission('manageContent'); }
    function canManageMessages() { return hasPermission('manageMessages'); }
    function canViewUsers() { return hasPermission('viewUsers') || hasPermission('manageUsers'); }
    function canViewAuditLogs() { return hasPermission('viewAuditLogs'); }
    function isConversationParticipant(roomId) {
      let roomPath = /databases/$(database)/documents/conversations/$(roomId);
      return signedIn() && exists(roomPath) && request.auth.uid in get(roomPath).data.participants;
    }
    function isNotBlockedByEither(uidA, uidB) {
      let aBlocksB = /databases/$(database)/documents/userBlocks/$(uidA)/blocked/$(uidB);
      let bBlocksA = /databases/$(database)/documents/userBlocks/$(uidB)/blocked/$(uidA);
      return !exists(aBlocksB) && !exists(bBlocksA);
    }
    function serviceIsUnlocked(slug) {
      let lockPath = /databases/$(database)/documents/serviceLocks/$(slug);
      return exists(lockPath)
        ? get(lockPath).data.isLocked == false
        : !(slug in ['cheti-kuzaliwa', 'visa-pasipoti', 'cheti-ndoa', 'ripoti-hasara']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canViewUsers());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'firstName', 'lastName', 'phone', 'name', 'username', 'tokenBalance', 'verificationStatus', 'role', 'permissions', 'createdAt', 'language', 'profileImageUrl', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.phone.matches('^255[67][0-9]{8}$')
        && phoneMatchesAuth(request.resource.data)
        && request.resource.data.role == 'user'
        && request.resource.data.tokenBalance == 0
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.permissions is map
        && request.resource.data.permissions.keys().size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['email', 'emailVerified'])
        && hasNoCredentialFields(request.resource.data);
      allow update: if signedIn() && hasNoCredentialFields(request.resource.data) && (
        (request.auth.uid == userId
          && !request.resource.data.keys().hasAny(['email', 'emailVerified'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'emailVerified', 'firstName', 'lastName', 'name', 'username', 'language', 'profileImageUrl', 'updatedAt'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.phone == resource.data.phone)
        || canManageUsers()
        || canManageTokens()
      );
      allow delete: if isSuperAdmin()
        && request.auth.uid != userId
        && resource.data.role != 'super_admin';
    }

    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /lipaServices/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /lipaApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageLipaApplications'));
      allow create, update, delete: if false;
    }
    match /lipaOpenApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageLipaApplications'));
      allow create, update, delete: if false;
    }
    match /serviceApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageServices'));
      allow create, update, delete: if false;
    }
    match /serviceOpenApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageServices'));
      allow create, update, delete: if false;
    }
    match /serviceLocks/{slug} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /tokenTransactions/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if false;
    }
    match /tokenPurchaseOrders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || canManageTokens());
      allow create, update, delete: if false;
    }
    match /licenseApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageReports'));
      allow create, update, delete: if false;
    }
    match /serviceUsage/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageReports'));
      allow create, update, delete: if false;
    }
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /tutorialVideos/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /serviceRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.serviceSlug is string
        && serviceIsUnlocked(request.resource.data.serviceSlug);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }
    match /licenseTemplates/{id} {
      allow read: if signedIn() && (resource.data.status == 'active' || isAdmin());
      allow create, update, delete: if false;
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
    match /messages/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /publicChatMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly(['senderId', 'text', 'filePath', 'fileName', 'fileType', 'replyTo', 'deliveredTo', 'readBy', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && (request.resource.data.text is string || request.resource.data.filePath is string);
      allow update: if signedIn()
        && resource.data.senderId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredTo', 'readBy'])
        && request.resource.data.deliveredTo.hasAll(resource.data.deliveredTo)
        && request.resource.data.readBy.hasAll(resource.data.readBy)
        && request.auth.uid in request.resource.data.readBy;
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }
    match /conversations/{roomId} {
      allow read: if isConversationParticipant(roomId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'names', 'phones', 'createdAt', 'updatedAt', 'lastMessage'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.names is map
        && request.resource.data.phones is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isNotBlockedByEither(request.resource.data.participants[0], request.resource.data.participants[1]);
      allow update: if isConversationParticipant(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isConversationParticipant(roomId);
        allow create: if isConversationParticipant(roomId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'filePath', 'fileName', 'fileType', 'replyTo', 'deliveredTo', 'readBy', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.deliveredTo == [request.auth.uid]
          && request.resource.data.readBy == [request.auth.uid]
          && (request.resource.data.text is string || request.resource.data.filePath is string)
          && isNotBlockedByEither(request.auth.uid, get(/databases/$(database)/documents/conversations/$(roomId)).data.participants[0] == request.auth.uid ? get(/databases/$(database)/documents/conversations/$(roomId)).data.participants[1] : get(/databases/$(database)/documents/conversations/$(roomId)).data.participants[0]);
        allow update: if isConversationParticipant(roomId)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredTo', 'readBy'])
          && request.resource.data.deliveredTo.hasAll(resource.data.deliveredTo)
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.auth.uid in request.resource.data.readBy;
        allow delete: if false;
      }
      match /typing/{userId} {
        allow read: if isConversationParticipant(roomId);
        allow create, update: if isConversationParticipant(roomId)
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if isConversationParticipant(roomId) && request.auth.uid == userId;
      }
    }
    match /userBlocks/{userId}/blocked/{targetUid} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && userId != targetUid;
      allow delete: if signedIn() && request.auth.uid == userId;
      allow update: if false;
    }
    match /userPresence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['online', 'lastSeen'])
        && request.resource.data.online is bool;
      allow delete: if false;
    }
    match /chatReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.roomId is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if false;
    }
    match /adminActions/{id} {
      allow read: if canViewAuditLogs();
      allow create: if isAdmin()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == request.auth.token.role
        && request.resource.data.action is string
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /auditLogs/{id} {
      allow read: if canViewAuditLogs();
      allow create: if false;
      allow update, delete: if false;
    }
    match /systemSettings/{id} {
      allow read, create, update, delete: if isSuperAdmin();
    }
  }
}
