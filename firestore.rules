rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isSuperAdmin() { return signedIn() && profile().role == 'super_admin'; }
    function isPrivileged() { return signedIn() && profile().role in ['admin', 'moderator', 'support', 'super_admin']; }
    function isAdmin() { return isPrivileged(); }
    function hasPermission(name) { return isSuperAdmin() || (isAdmin() && profile().permissions[name] == true); }
    function hasNoCredentialFields(data) { return !data.keys().hasAny(['password', 'pin', 'pinHash']); }
    function canManageUsers() { return hasPermission('manageUsers'); }
    function canManageTokens() { return hasPermission('manageTokens'); }
    function canManageServices() { return hasPermission('manageServices'); }
    function canManageContent() { return hasPermission('manageContent'); }
    function canManageMessages() { return hasPermission('manageMessages'); }
    function canViewUsers() { return hasPermission('viewUsers') || hasPermission('manageUsers'); }
    function canViewAuditLogs() { return hasPermission('viewAuditLogs'); }
    function serviceIsUnlocked(slug) {
      let lockPath = /databases/$(database)/documents/serviceLocks/$(slug);
      return exists(lockPath)
        ? get(lockPath).data.isLocked == false
        : !(slug in ['cheti-kuzaliwa', 'visa-pasipoti', 'cheti-ndoa', 'ripoti-hasara']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canViewUsers());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'firstName', 'lastName', 'phone', 'name', 'username', 'tokenBalance', 'verificationStatus', 'role', 'permissions', 'createdAt', 'language', 'profileImageUrl', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.tokenBalance == 0
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.permissions is map
        && request.resource.data.permissions.keys().size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasNoCredentialFields(request.resource.data);
      allow update: if signedIn() && hasNoCredentialFields(request.resource.data) && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email', 'firstName', 'lastName', 'phone', 'name', 'username', 'language', 'profileImageUrl', 'updatedAt', 'createdAt', 'role', 'tokenBalance', 'verificationStatus', 'permissions', 'password', 'pin', 'pinHash'])
          && (resource.data.keys().hasAny(['uid']) ? request.resource.data.uid == resource.data.uid : request.resource.data.uid == userId)
          && (resource.data.keys().hasAny(['role']) ? request.resource.data.role == resource.data.role : request.resource.data.role == 'user')
          && (resource.data.keys().hasAny(['tokenBalance']) ? request.resource.data.tokenBalance == resource.data.tokenBalance : request.resource.data.tokenBalance == 0)
          && (resource.data.keys().hasAny(['verificationStatus']) ? request.resource.data.verificationStatus == resource.data.verificationStatus : request.resource.data.verificationStatus == 'pending')
          && (resource.data.keys().hasAny(['permissions']) ? request.resource.data.permissions == resource.data.permissions : request.resource.data.permissions is map && request.resource.data.permissions.keys().size() == 0)
          && (resource.data.keys().hasAny(['accountStatus']) ? request.resource.data.accountStatus == resource.data.accountStatus : !request.resource.data.keys().hasAny(['accountStatus']))
          && (resource.data.keys().hasAny(['createdAt']) ? request.resource.data.createdAt == resource.data.createdAt : request.resource.data.createdAt == request.time))
      );
      allow delete: if isSuperAdmin()
        && request.auth.uid != userId
        && resource.data.role != 'super_admin';
    }

    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /lipaServices/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /lipaApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageLipaApplications'));
      allow create, update, delete: if false;
    }
    match /lipaOpenApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageLipaApplications'));
      allow create, update, delete: if false;
    }
    match /serviceApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageServices'));
      allow create, update, delete: if false;
    }
    match /serviceOpenApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageServices'));
      allow create, update, delete: if false;
    }
    match /serviceLocks/{slug} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /tokenTransactions/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if false;
    }
    match /tokenPurchaseOrders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || canManageTokens());
      allow create, update, delete: if false;
    }
    match /licenseApplications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageReports'));
      allow create, update, delete: if false;
    }
    match /serviceUsage/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('manageReports'));
      allow create, update, delete: if false;
    }
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /tutorialVideos/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /serviceRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.serviceSlug is string
        && serviceIsUnlocked(request.resource.data.serviceSlug);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }
    match /licenseTemplates/{id} {
      allow read: if signedIn() && (resource.data.status == 'active' || isAdmin());
      allow create, update, delete: if false;
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
    match /messages/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /adminActions/{id} {
      allow read: if canViewAuditLogs();
      allow create: if isAdmin()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == profile().role
        && request.resource.data.action is string
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /auditLogs/{id} {
      allow read: if canViewAuditLogs();
      allow create: if false;
      allow update, delete: if false;
    }
    match /systemSettings/{id} {
      allow read, create, update, delete: if isSuperAdmin();
    }
  }
}
