rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isSuperAdmin() { return signedIn() && profile().role == 'super_admin'; }
    function isAdmin() { return signedIn() && (isSuperAdmin() || profile().role == 'admin'); }
    function hasPermission(name) { return isSuperAdmin() || (isAdmin() && profile().permissions[name] == true); }
    function canManageUsers() { return hasPermission('manageUsers'); }
    function canManageTokens() { return hasPermission('manageTokens'); }
    function canManageServices() { return hasPermission('manageServices'); }
    function canManageContent() { return hasPermission('manageContent'); }
    function canManageMessages() { return hasPermission('manageMessages'); }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.tokenBalance == 0;
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.tokenBalance == resource.data.tokenBalance
          && request.resource.data.verificationStatus == resource.data.verificationStatus
          && request.resource.data.permissions == resource.data.permissions)
        || isSuperAdmin()
        || (canManageUsers()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'tokenBalance']))
        || (canManageTokens()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokenBalance', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if canManageServices();
    }
    match /tokenTransactions/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if canManageTokens() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if canManageContent();
    }
    match /tutorialVideos/{id} {
      allow read: if true;
      allow create, update, delete: if canManageContent();
    }
    match /serviceRequests/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }
    match /licenseTemplates/{id} {
      allow read: if signedIn() && (resource.data.status == 'active' || isAdmin());
      allow create, update, delete: if isSuperAdmin();
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }
    match /messages/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow create, update, delete: if canManageMessages();
    }
    match /adminActions/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /auditLogs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /systemSettings/{id} {
      allow read, create, update, delete: if isSuperAdmin();
    }
  }
}
